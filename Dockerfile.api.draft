# OpenMuse API image for Azure Container Apps (jlsmrs/openmuse fork).
# Built from the repo root.
# Build: pnpm install --frozen-lockfile && pnpm build:server
# Run: node dist/apps/server/src/index.js (repo "start" script)
# Listens on $PORT (default 8787). DATA_DIR is mounted from Azure Files at runtime.
# Base: Node 24 LTS (repo requires >=22; Render uses node runtime, packageManager pnpm@11.19.0).

FROM node:24-bookworm-slim AS build
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@11.19.0 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json tsconfig.build.json ./
COPY apps/server ./apps/server
COPY packages ./packages
COPY patches ./patches
RUN pnpm install --frozen-lockfile && pnpm build:server && pnpm prune --prod

FROM node:24-bookworm-slim AS run
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app/package.json /app/pnpm-lock.yaml /app/pnpm-workspace.yaml ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY --from=build /app/apps/server ./apps/server
EXPOSE 8787
CMD ["node", "dist/apps/server/src/index.js"]
