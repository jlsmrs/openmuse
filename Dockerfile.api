# OpenMuse API image for Azure Container Apps (jlsmrs/openmuse fork).
# Built from the repo root.
# 
# Build: pnpm install --frozen-lockfile && pnpm build:server
# Run: node dist/apps/server/src/index.js (repo "start" script)
# Listens on $PORT (default 8787). DATA_DIR is mounted from Azure Files at runtime.
# Base: Node 24 LTS (repo requires >=22; Render uses node runtime, packageManager pnpm@11.19.0).
FROM node:24-bookworm-slim AS build
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@11.19.0 --activate
# Copy the full repo: the workspace includes apps/mobile, and pnpm fails
# with ERR_PNPM_UNUSED_PATCH if the metro patch is present but metro itself
# is absent from the install tree (the selective-copy attempt failed this way).
COPY . .
RUN pnpm install --frozen-lockfile && pnpm build:server && CI=true pnpm prune --prod
FROM node:24-bookworm-slim AS run
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build --chown=node:node /app/package.json /app/pnpm-lock.yaml /app/pnpm-workspace.yaml ./
COPY --from=build --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/dist ./dist
COPY --from=build --chown=node:node /app/apps/server ./apps/server
# The API container runs as the image's non-root node user, like the worker
# image drops to pwuser. /app is owned by node so the default DATA_DIR
# (/app/.openmuse) and any runtime writes under it work; an Azure Files
# DATA_DIR mount's writability under this user is verified in staging
# before deploy.
USER node
EXPOSE 8787
CMD ["node", "dist/apps/server/src/index.js"]
